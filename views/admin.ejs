<!DOCTYPE html>
<html>
<head>

    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body class="bg-light">

<div class="container mt-5">

    <h1 class="text-center mb-5">
        Admin Dashboard
    </h1>

    <!-- Statistics Cards -->
    <div class="row">

        <!-- Products -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-primary shadow">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam display-4"></i>
                    <h5 class="mt-3">Products</h5>
                    <h2><%= products %></h2>
                </div>
            </div>
        </div>

        <!-- Users -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-success shadow">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill display-4"></i>
                    <h5 class="mt-3">Users</h5>
                    <h2><%= users %></h2>
                </div>
            </div>
        </div>

        <!-- Orders -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-warning shadow">
                <div class="card-body text-center">
                    <i class="bi bi-cart-check-fill display-4"></i>
                    <h5 class="mt-3">Orders</h5>
                    <h2><%= orders %></h2>
                </div>
            </div>
        </div>

        <!-- Revenue -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-danger shadow">
                <div class="card-body text-center">
                    <i class="bi bi-currency-dollar display-4"></i>
                    <h5 class="mt-3">Revenue</h5>
                    <h2>Rs. <%= revenue %></h2>
                </div>
            </div>
        </div>

    </div>

    <hr>

    <!-- Admin Buttons -->
    <div class="text-center mb-5">

        <a href="/admin/products" class="btn btn-primary btn-lg m-2">
            <i class="bi bi-box"></i> Manage Products
        </a>

        <a href="/admin/users" class="btn btn-success btn-lg m-2">
            <i class="bi bi-people"></i> Manage Users
        </a>

        <a href="/admin/orders" class="btn btn-warning btn-lg m-2">
            <i class="bi bi-cart"></i> Manage Orders
        </a>

        <a href="/" class="btn btn-dark btn-lg m-2">
            <i class="bi bi-house"></i> Back to Store
        </a>

    </div>

    <!-- Latest Products -->
    <h3 class="mb-3">Latest Products</h3>

    <ul class="list-group mb-5">
        <% latestProducts.forEach(product => { %>

            <li class="list-group-item d-flex justify-content-between">
                <strong><%= product.name %></strong>
                <span>Rs. <%= product.price %></span>
            </li>

        <% }) %>
    </ul>

    <!-- Latest Users -->
    <h3 class="mb-3">Latest Users</h3>

    <ul class="list-group mb-5">
        <% latestUsers.forEach(user => { %>

            <li class="list-group-item">
                <strong><%= user.name %></strong> -
                <%= user.email %>
            </li>

        <% }) %>
    </ul>

    <!-- Latest Orders -->
    <h3 class="mb-3">Latest Orders</h3>

    <ul class="list-group mb-5">
        <% latestOrders.forEach(order => { %>

            <li class="list-group-item d-flex justify-content-between">
                <span><%= order.user %></span>
                <strong>Rs. <%= order.total %></strong>
            </li>

        <% }) %>
    </ul>

    <hr class="my-5">

    <!-- Chart -->
    <h3 class="text-center mb-4">
        Store Statistics
    </h3>

    <canvas id="statsChart" height="100"></canvas>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const ctx = document.getElementById('statsChart');

new Chart(ctx, {

    type: 'bar',

    data: {

        labels: [
            'Products',
            'Users',
            'Orders',
            'Revenue'
        ],

        datasets: [{

            label: 'Store Statistics',

            data: [
                <%= products %>,
                <%= users %>,
                <%= orders %>,
                <%= revenue %>
            ],

            backgroundColor: [
                '#0d6efd',
                '#198754',
                '#ffc107',
                '#dc3545'
            ],

            borderWidth: 1

        }]

    },

    options: {

        responsive: true,

        scales: {

            y: {

                beginAtZero: true

            }

        }

    }

});

</script>

</body>
</html>